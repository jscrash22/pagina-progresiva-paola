{
  "name": "Papelería Paola",
  "short_name": "Papelería",
  "description": "Tienda de papelería progresiva con carrito, modo sin conexión y formularios persistentes.",
  "lang": "es",
  "dir": "ltr",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#5b4ce6",
